{
  "name": "dsh-work-skin",
  "version": "1.1.0",
  "description": "DSH 一键换肤 · 在海边写代码，让窗边猫咪陪你聊天，或上传自己的图片。13 套自适应壁纸与界面配色，重启接着用。",
  "type": "module",
  "license": "MIT",
  "author": "superShen0916",
  "repository": "github:superShen0916/dsh-work-skin",
  "keywords": ["dsh-plugin", "deepseek-harness", "theme", "skin", "wallpaper"],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/", "assets/", "cordis.patch.yml"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --check lib/client.js",
    "test": "node --test",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "playwright-core": "1.65.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
